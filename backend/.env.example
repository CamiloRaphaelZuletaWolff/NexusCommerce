# NexusCommerce backend — environment template (Spring Boot, scaffolded in Phase 2)
# Spring reads these via application.yml placeholders (${VAR}). Copy to `.env`
# or export in your shell. Values below assume the default infra/.env.

# --- PostgreSQL (JPA) ---------------------------------------------------------
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/nexuscommerce
SPRING_DATASOURCE_USERNAME=nexus
SPRING_DATASOURCE_PASSWORD=nexus_local_pw

# --- MongoDB (catalog) --------------------------------------------------------
SPRING_DATA_MONGODB_URI=mongodb://nexus_app:mongo_app_local_pw@localhost:27017/nexuscatalog

# --- JWT (stateless auth, Phase 2) --------------------------------------------
# Base64-encoded 256-bit secret. Generate a real one per environment, e.g.:
#   openssl rand -base64 32
JWT_SECRET=replace-with-base64-encoded-256-bit-secret
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7

# --- Column encryption key (sensitive payment fields, Phase 4) ----------------
# AES key material, base64-encoded. Never reuse the JWT secret here.
APP_ENCRYPTION_KEY=replace-with-base64-encoded-aes-256-key

# --- Server -------------------------------------------------------------------
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev
