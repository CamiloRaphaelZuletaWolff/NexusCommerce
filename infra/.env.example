# NexusCommerce — local infrastructure credentials
# Copy this file to `.env` (same directory) before running docker compose.
# `.env` is gitignored; never commit real secrets.

# --- PostgreSQL ---------------------------------------------------------------
POSTGRES_DB=nexuscommerce
POSTGRES_USER=nexus
POSTGRES_PASSWORD=nexus_local_pw
POSTGRES_PORT=5432

# --- MongoDB ------------------------------------------------------------------
# Root account (admin). The init script creates a separate least-privilege
# application user (MONGO_APP_USER) scoped to the catalog database only.
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=mongo_root_local_pw
MONGO_DB=nexuscatalog
MONGO_APP_USER=nexus_app
MONGO_APP_PASSWORD=mongo_app_local_pw
MONGO_PORT=27017

# --- pgAdmin (profile: tools) -------------------------------------------------
PGADMIN_DEFAULT_EMAIL=admin@nexus.local
PGADMIN_DEFAULT_PASSWORD=admin
PGADMIN_PORT=5050

# --- mongo-express (profile: tools) -------------------------------------------
MONGO_EXPRESS_PORT=8081
