# NexusCommerce frontend — environment template (Next.js, scaffolded in Phase 5)
# Copy to `.env.local`. Only NEXT_PUBLIC_* values are exposed to the browser.

# Base URL of the Spring Boot API.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api

# Server-side only (used by Route Handlers / Server Components if needed).
API_INTERNAL_BASE_URL=http://localhost:8080/api
