# NexusCommerce frontend — environment template (Next.js 15, Phase 5)
# Copy to `.env.local`. Only NEXT_PUBLIC_* values are exposed to the browser.

# Base URL of the Spring Boot API, used by the browser client (lib/api.ts).
# Must be reachable from the user's browser and have CORS allowing this origin
# with credentials (the backend already allows http://localhost:3000).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api

# Base URL used by Server Components / RSC data fetching (lib/server-api.ts).
# Server-to-server, so it can point at an internal hostname in Docker.
API_INTERNAL_BASE_URL=http://localhost:8080/api
